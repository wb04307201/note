#!/usr/bin/env bash
# pre-commit hook: 知识库 .md 链接完整性检查
# 启用: git config core.hooksPath .githooks（CLAUDE.md 文档化）
#
# 安装: git config core.hooksPath .githooks
# 或通过 setup.sh（保留兼容入口，但新环境可直接手动配）

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 知识库 .md 新增/修改时跑链接完整性检查（平铺结构：内容在仓库根）
# 排除 .claude/skills/ scripts/ .health-tmp/ 等非知识内容目录
# --diff-filter=AM 避免 staged 删除触发"文件不存在"误报
STAGED_NOTE=$(git diff --cached --name-only --diff-filter=AM | grep "\.md$" | grep -vE "^(\.claude/skills/|\.github/|\.health-tmp/)" || true)
if [ -n "$STAGED_NOTE" ]; then
  CHECK_SCRIPT="$REPO_ROOT/.github/workflows/scripts/check-broken-links.py"
  if [ -f "$CHECK_SCRIPT" ]; then
    FILE_COUNT=$(echo "$STAGED_NOTE" | wc -l)
    echo "[pre-commit] 知识库有 $FILE_COUNT 个 .md 变更，跑链接完整性检查..."
    CHECK_OK=0
    python "$CHECK_SCRIPT" --quiet $STAGED_NOTE || CHECK_OK=1
    if [ "$CHECK_OK" -ne 0 ]; then
      echo ""
      echo "❌ 链接完整性检查未通过，请修复断链后再 commit"
      echo "   详见: python scripts/check-broken-links.py --help"
      echo ""
      # 给出修复建议
      echo "   修复方法："
      echo "   1. 跑 python scripts/check-broken-links.py <file>  看具体断链"
      echo "   2. 修正目标路径或删除孤链（参考 note-precipitation-planning §7.1）"
      echo "   3. 用 git commit --no-verify 临时绕过（不推荐）"
      exit 1
    fi
  fi

  # Frontmatter status: 字段检查（2026-10-12 候选 5）
  # 当前 WARN 模式（不阻断），待全库 batch 加 status:active 后升级为 ABORT
  MISSING_STATUS_COUNT=0
  MISSING_STATUS_LIST=""
  for f in $STAGED_NOTE; do
    # 跳过 README.md / SPEC.md / index.md（豁免，按 SPEC §3 / §4 约定）
    base=$(basename "$f")
    if [ "$base" = "README.md" ] || [ "$base" = "SPEC.md" ] || [ "$base" = "index.md" ]; then
      continue
    fi
    # 检查是否有 frontmatter（含 module:/question:/story: 之一）+ status: 字段
    if grep -qE '<!--(module|question|story):' "$f" 2>/dev/null; then
      if ! grep -qE '<!--(module|question|story):[^-]*status:[ ]*\(draft|active|deprecated|orphaned\)' "$f" 2>/dev/null; then
        MISSING_STATUS_COUNT=$((MISSING_STATUS_COUNT + 1))
        MISSING_STATUS_LIST="$MISSING_STATUS_LIST\n    $f"
      fi
    fi
  done
  if [ "$MISSING_STATUS_COUNT" -gt 0 ]; then
    echo "[pre-commit-status] ⚠ WARN: $MISSING_STATUS_COUNT 个 .md 缺失 status: 字段（候选 5 强制策略 · WARN 阶段）:"
    echo -e "$MISSING_STATUS_LIST"
    echo "[pre-commit-status] ⚠ 待全库 batch 加 status:active 后升级为 ABORT（参考 SPEC.md §4）"
    # 注意: 当前为 WARN 模式，commit 仍可继续
  fi
fi