#!/usr/bin/env bash
# pre-commit hook: 知识库 .md 链接完整性检查
# 启用: git config core.hooksPath .githooks（CLAUDE.md 文档化）
#
# 安装: git config core.hooksPath .githooks
# 或通过 setup.sh（保留兼容入口，但新环境可直接手动配）

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"

# 知识库 .md 新增/修改时跑链接完整性检查（平铺结构：内容在仓库根）
# 排除 .claude/skills/ scripts/ .health-tmp/ 等非知识内容目录
# --diff-filter=AM 避免 staged 删除触发"文件不存在"误报
STAGED_NOTE=$(git diff --cached --name-only --diff-filter=AM | grep "\.md$" | grep -vE "^(\.claude/skills/|\.github/|\.health-tmp/)" || true)
if [ -n "$STAGED_NOTE" ]; then
  CHECK_SCRIPT="$REPO_ROOT/.github/workflows/scripts/check-broken-links.py"
  if [ -f "$CHECK_SCRIPT" ]; then
    FILE_COUNT=$(echo "$STAGED_NOTE" | wc -l)
    echo "[pre-commit] 知识库有 $FILE_COUNT 个 .md 变更，跑链接完整性检查..."
    CHECK_OK=0
    python "$CHECK_SCRIPT" --quiet $STAGED_NOTE || CHECK_OK=1
    if [ "$CHECK_OK" -ne 0 ]; then
      echo ""
      echo "❌ 链接完整性检查未通过，请修复断链后再 commit"
      echo "   详见: python scripts/check-broken-links.py --help"
      echo ""
      # 给出修复建议
      echo "   修复方法："
      echo "   1. 跑 python scripts/check-broken-links.py <file>  看具体断链"
      echo "   2. 修正目标路径或删除孤链（参考 note-precipitation-planning §7.1）"
      echo "   3. 用 git commit --no-verify 临时绕过（不推荐）"
      exit 1
    fi
  fi
fi